{
  "permissions": {
    "allow": [
      "Bash(python tools/build.py)",
      "Bash(python tools/check_all.py:*)",
      "Bash(python lint/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh label create:*)",
      "Edit(src/**)",
      "Edit(assets/**)",
      "Edit(reviews/**)",
      "Edit(research/**)",
      "Edit(docs/**)",
      "Edit(lint/rules_applied.txt)",
      "Edit(HANDOFF.md)",
      "Edit(FAILURES.md)",
      "Edit(DASHBOARD.md)"
    ],
    "ask": [],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Edit(.claude/settings.json)",
      "Edit(NEW_BOOK_PLAYBOOK.md)",
      "Edit(HARNESS_SETUP.md)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/session_start.py\""}]}],
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/pre_bash.py\""}]}],
    "PostToolUse": [{"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hook_lint.py\"", "timeout": 120}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/stop_check.py\"", "timeout": 300}]}]
  }
}
